{% extends 'base.html.twig' %}

{% block title %}Invitation - Tâches{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card-dark p-4"> 
                <div class="card-title mb-4">
                    <i class="bi bi-person-plus"></i> Inviter un collaborateur
                </div>

                {{ form_start(inviteForm, {'action': path('app_task_invite'), 'method': 'POST'}) }}
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label-dark">Email du collaborateur</label>
                            {{ form_widget(inviteForm.email, {'attr': {'class': 'input-dark', 'placeholder': 'collaborateur@email.com'}}) }}
                        </div>
                        
                        <div class="col-12">
                            <label class="form-label-dark">Message d'invitation (optionnel)</label>
                            <textarea class="input-dark" name="invite_message" rows="4" placeholder="Bonjour, je vous invite à collaborer..."></textarea>
                        </div>

                        <div class="col-12 d-flex gap-2 mt-4">
                            <button type="submit" class="btn-accent" style="flex:1;">
                                <i class="bi bi-send"></i> Envoyer l'invitation
                            </button>
                            <a href="{{ path('app_task_invite') }}" class="btn-outline">Annuler</a>
                        </div>
                    </div>
                {{ form_end(inviteForm) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}