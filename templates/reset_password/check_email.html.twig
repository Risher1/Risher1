{# check_email.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Email envoyé{% endblock %}
{% block body %}

<main style="flex:1; display:flex; align-items:center; justify-content:center; padding:2rem 0; min-height:calc(100vh - 62px - 70px);">
    <div style="background-color:#11141f; border:1px solid #1e2338; border-radius:14px; padding:2.5rem; width:100%; max-width:420px; text-align:center;"
         class="fade-in">

        {# Icône centrale #}
        <div style="width:64px; height:64px; background-color:rgba(167,139,250,0.12); border:1px solid rgba(167,139,250,0.3); border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.5rem;">
            <i class="bi bi-envelope-check" style="font-size:26px; color:#a78bfa;"></i>
        </div>

        {# Logo #}
        <div style="font-family:'Syne',sans-serif; font-size:22px; font-weight:800; color:#f1f5f9; margin-bottom:8px;">
            Email envoyé !
        </div>

        <p style="font-size:13px; color:#6b7280; line-height:1.7; margin-bottom:1rem;">
            Si un compte correspond à l'adresse  email, un lien de réinitialisation vient d'être envoyé.
        </p>

        {# Bloc expiration #}
        <div style="background-color:rgba(167,139,250,0.08); border:1px solid rgba(167,139,250,0.2); border-radius:10px; padding:12px 16px; margin-bottom:1.5rem; font-size:12px; color:#a78bfa; display:flex; align-items:center; justify-content:center; gap:8px;">
            <i class="bi bi-clock"></i>
            Ce lien expirera dans
            <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>
        </div>

        <p style="font-size:12px; color:#6b7280; margin-bottom:1.5rem; line-height:1.6;">
            Vous n'avez pas reçu d'email ? Vérifiez vos spams ou
            <a href="{{ path('app_forgot_password_request') }}"
               style="color:#a78bfa; text-decoration:none; font-weight:600;">
                réessayez
            </a>.
        </p>

        <a href="{{ path('app_login') }}"
           style="background-color:transparent; color:#6b7280; border:1px solid #1e2338; border-radius:10px; padding:9px 20px; font-family:'Syne',sans-serif; font-size:13px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:7px; text-decoration:none; transition:all 0.2s ease;">
            <i class="bi bi-arrow-left"></i> Retour à la connexion
        </a>

    </div>
</main>

{% endblock %}
